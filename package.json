{
  "name": "easy-marko",
  "version": "0.0.0",
  "description": "A web-based markdown editor with offline support, installable as a PWA",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "server:status": "node scripts/server.mjs status",
    "server:stop": "node scripts/server.mjs stop"
  },
  "license": "MIT",
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.0-rc.6",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.38",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/markdown-it": "^14.2.0",
    "eslint-plugin-solid": "~0.18.0",
    "jsdom": "^25.0.1",
    "oxlint": "~1.79.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@solidjs/web": "^2.0.0-rc.6",
    "@vscode/markdown-it-katex": "^1.1.2",
    "katex": "^0.16.47",
    "lucide": "^1.44.0",
    "markdown-it": "^15.0.2",
    "solid-js": "^2.0.0-rc.6"
  }
}
